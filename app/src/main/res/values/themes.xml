<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CristalGiro" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:colorPrimary">@color/ice</item>
    </style>

    <style name="Theme.CristalGiro.Launcher" parent="Theme.CristalGiro">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
